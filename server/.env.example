PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5500
# Stripe — renseigner les valeurs uniquement dans Northflank
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
STRIPE_SUCCESS_URL=https://votre-domaine.example/?stripe=success
STRIPE_CANCEL_URL=https://votre-domaine.example/?stripe=cancel
STRIPE_PORTAL_RETURN_URL=https://votre-domaine.example/#dashboard

# Google Sign-In — créer un OAuth 2.0 Client ID Web dans Google Cloud
GOOGLE_CLIENT_ID=
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Conformité KYC/AML — secrets à renseigner uniquement dans le gestionnaire de secrets de production
COMPLIANCE_ENFORCEMENT=true
COMPLIANCE_WEBHOOK_SECRET=
KYC_PROVIDER_URL=
AML_PROVIDER_URL=

# Agent Payments — AP2-compatible authorization / x402 readiness
AGENT_PAYMENT_ENFORCEMENT=true
AGENT_PAYMENT_MANDATE_SECRET=
PAYMENT_RAIL_MODE=simulation
# OpenFacilitator x402 — aucun settlement réel sans activation explicite
X402_FACILITATOR_URL=https://pay.openfacilitator.io
X402_FACILITATOR_ENABLED=false
X402_SETTLEMENT_ENABLED=false

# Bot AI engine — simulation uniquement pour l'exécution du portefeuille
BOT_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
BOT_AI_TIMEOUT_MS=7000
BOT_AI_CACHE_MS=300000
